node_modules/
dist/
# zcode-server-cli release staging output; locally assembled artifacts stay out of the repo.
dist-release/
# macOS CI isolates electron-builder output dirs per arch; these remain build artifacts.
packages/desktop/dist-*/
out/
prebuilds/
bundled-resources/
mock-cdn/
packages/desktop/bundled-resources/
packages/desktop/bundled-agents/
packages/desktop/bundled-tools/
packages/desktop/mock-cdn/
*.tsbuildinfo
.DS_Store
coverage/
.env.local
.env.*.local
.env
.VSCodeCounter
.idea/
.zed/
.cache
# CI keeps these download caches across tasks; they must not enter untracked-source enumeration.
/.electron-builder-cache/
/.electron-cache/
/.pnpm-store/
/.npm-cache/
.turbo/
z-work/
openclaw/
.run-logs/
.worktrees/
packages/stream-animate/dist-server/
packages/stream-animate/.stream-animate-data/
.codegraph
.mimosa/
# Integration branches previously picked up node-gyp build artifacts and .playwright-mcp temp snapshots;
# repo hygiene (scripts/ci/ci-repo-hygiene.mjs) rejects them in CI; this also ignores them for local git add.
.playwright-mcp/
*.o
.deps/
obj.target/
config.gypi
gyp-mac-tool
*.target.mk
binding.Makefile
# These two patterns were originally build/Makefile and build/Release/*.node; patterns with
# an inner slash only match relative to this file's directory (repo root), missing artifacts
# under packages/ax-macos/build/, while ci-repo-hygiene.mjs's denylist matches any depth via
# (^|/)build/... - artifacts that slip past slash-less patterns get re-added by git add -A.
# The **/ prefix aligns the ignore scope with the gate scope.
**/build/Makefile
**/build/Release/*.node

# Swift helper binary for the CUA permission snap overlay (built by
# prepare:macos-window-bounds from packages/desktop/native/macos-window-bounds/main.swift;
# source is tracked, artifacts are not)
packages/desktop/resources/macos-window-bounds/
# CUA Helper SEA base download cache (the official Node 22 runtime fetched by
# scripts/cua-helper-sea-base.mjs; pure download artifact)
/.tmp/
# Python bytecode (generated when docker/plugin-eval/summarize.py runs on the host).
__pycache__/
*.pyc

# Local tool run artifacts, all regenerable: desktop e2e screenshots/caches/network
# captures, and the desktop dev runner's Electron download cache.
packages/desktop/.e2e-artifacts/
packages/desktop/.e2e-cache/
packages/desktop/.e2e-network-capture/
.zcode-runtime/

# ===== everything above is synced from .gitignore (the sync rewrites only this part) =====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
htmlcov/
lcov-report/
cmakefiles/
