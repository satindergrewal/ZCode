{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/scheduler",
    "rootDir": "src/scheduler",
    "lib": ["es2025"],
    // scheduler only uses Electron.MessageEvent as a type and does not import the "electron" value,
    // so node + electron global types (process/setInterval/Electron namespace) are explicit here.
    "types": ["node", "electron"]
  },
  "include": ["src/scheduler"],
  // scheduler depends on services (node entry)/shared; references reuse upstream declaration outputs.
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
