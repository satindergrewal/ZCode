{
  "extends": "../../tsconfig.base.json",
  // The ui package keeps NodeNext ESM resolution, so intra-package imports must resolve to real
  // file paths. ai-elements used to self-reference @zcode/ui/... from inside the package while
  // omitting many internal .js suffixes, tripping both package-exports restrictions and NodeNext
  // path resolution. The existing config is kept: intra-package imports are normalized onto
  // .js-sufficed relative paths so dev, build, and typecheck agree.
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Under some tsserver/incremental-project states, a directory include ("src") admits that new
  // files exist and are expanded by CLI `tsc --showConfig`, yet the editor still briefly reports
  // "file not in project". Explicit globs force every ts/tsx/d.ts source under the ui package into
  // the project so newly added modules (e.g. settings helpers) are never misjudged as missing.
  // src json files (e.g. provider-icons data under assets) are included too so resolveJsonModule
  // imports land in the project file list.
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "src/**/*.json"],
  // ui consumes rpc types directly too; with the project references in place ui no longer
  // rechecks rpc sources as its own inputs.
  "references": [
    { "path": "../provider" },
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../rpc" }
  ]
}
