{
  // composite project: consumers used to pull the rpc sources in via the package export and
  // check them twice. As a stand-alone project consumable via project references, typecheck
  // reuses the declarations rpc emits itself, so the same errors are not printed again.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    // Why: the old @types/css-font-loading-module pulled in transitively by rrweb duplicates
    // the DOM declarations built into newer TypeScript. rpc does not extend the root tsconfig
    // and previously did not skip lib checks, so bootstrap failed on dependency type conflicts.
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
