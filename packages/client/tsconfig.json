{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025", "dom", "dom.iterable"]
  },
  "include": ["src"],
  // client depends on rpc directly; without an explicit rpc project reference, typecheck would
  // recompile the rpc sources through the workspace package entry.
  // With the reference in place, client reads the declaration files rpc already emitted.
  "references": [{ "path": "../services" }, { "path": "../rpc" }]
}
