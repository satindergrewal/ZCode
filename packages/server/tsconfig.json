{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2022"]
  },
  "include": ["src"],
  // server directly imports shared / services / client / rpc.
  // The references used to be incomplete, so builds fell back to pulling
  // sources through package entries and amplified rpc errors repeatedly.
  "references": [
    { "path": "../shared" },
    { "path": "../services" },
    { "path": "../client" },
    { "path": "../rpc" }
  ]
}
