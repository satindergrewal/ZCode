{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["es2025"],
    "types": ["node"]
  },
  "include": ["src"],
  // Without a project reference to rpc, tsc re-checked rpc as plain sources and the same errors
  // reappeared in every consumer.
  // The references let services consume rpc's declaration output directly.
  "references": [{ "path": "../shared" }, { "path": "../rpc" }]
}
